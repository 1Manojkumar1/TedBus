PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tedbus
CORS_ORIGIN=http://localhost:4200
APP_URL=http://localhost:4200

# Google sign-in. Leave empty to keep the API in open/demo mode.
GOOGLE_CLIENT_ID=

# Set to true to require a valid Google ID token on booking/customer writes.
AUTH_REQUIRED=false

# Payments: auto (Stripe if key present, otherwise mock), stripe, or mock.
PAYMENT_MODE=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
